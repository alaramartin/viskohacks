{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://walk-home.local/shared/waypoint.schema.json",
    "title": "RoutesResponse",
    "description": "Response of GET /api/routes. A route is an ordered list of Waypoints. Consecutive waypoints sharing a block_id belong to one Orbis session.",
    "type": "object",
    "required": ["routes"],
    "additionalProperties": false,
    "properties": {
        "routes": {
            "type": "array",
            "items": { "$ref": "#/$defs/Route" }
        }
    },
    "$defs": {
        "Route": {
            "type": "object",
            "required": ["route_id", "waypoints"],
            "additionalProperties": false,
            "properties": {
                "route_id": { "type": "string", "examples": ["A", "B"] },
                "waypoints": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Waypoint" }
                }
            }
        },
        "Waypoint": {
            "type": "object",
            "required": [
                "index",
                "lat",
                "lng",
                "heading",
                "block_id",
                "image_url",
                "image_available",
                "condition"
            ],
            "additionalProperties": false,
            "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                "lng": { "type": "number", "minimum": -180, "maximum": 180 },
                "heading": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 360,
                    "description": "Bearing in degrees to the next waypoint (0 = north, clockwise)."
                },
                "block_id": {
                    "type": "string",
                    "description": "Stable id for the street segment between two intersections. Consecutive waypoints sharing it belong to one Orbis session."
                },
                "image_url": {
                    "type": ["string", "null"],
                    "description": "e.g. /api/imagery/<block_id>/<heading>. null when image_available is false."
                },
                "image_available": {
                    "type": "boolean",
                    "description": "false => image_url is null and the renderer must show the unavailable state."
                },
                "condition": { "$ref": "#/$defs/Condition" }
            },
            "if": { "properties": { "image_available": { "const": false } } },
            "then": { "properties": { "image_url": { "type": "null" } } },
            "else": { "properties": { "image_url": { "type": "string" } } }
        },
        "Condition": {
            "type": "object",
            "required": ["video_prompt", "audio_prompt", "facts"],
            "additionalProperties": false,
            "properties": {
                "video_prompt": {
                    "type": "string",
                    "description": "Passed straight to Orbis set_prompt."
                },
                "audio_prompt": {
                    "type": "string",
                    "description": "Passed straight to Orbis set_audio_prompt."
                },
                "facts": {
                    "type": "array",
                    "description": "Rendered verbatim in the evidence readout. Person 1 owns the wording.",
                    "items": { "$ref": "#/$defs/Fact" }
                },
                "lighting": { "$ref": "#/$defs/Lighting" }
            }
        },
        "Lighting": {
            "type": "object",
            "description": "PROPOSED after the Person 2 spike, not yet agreed. Structured lighting for the day->night seed grade. Optional so the fixture and older consumers stay valid.",
            "required": ["lit", "lamp_count", "side", "lamp_offsets_m", "outages"],
            "additionalProperties": false,
            "properties": {
                "lit": {
                    "enum": ["yes", "no", "unknown"],
                    "description": "OSM lit tag on this block's edges (and the street beside a mapped sidewalk)."
                },
                "lamp_count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Mapped streetlights on the whole block (Mapillary detections, clustered, plus OSM street_lamp)."
                },
                "side": {
                    "enum": ["both", "one", "none"],
                    "description": "Which sides of the walked line the block's lamps are on."
                },
                "lamp_offsets_m": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "description": "Metres ahead of this waypoint, along the route, of each lamp still ahead on this block. Ascending."
                },
                "outages": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "311 streetlight-out reports within 30m of the block in the 90 days before the requested time."
                }
            }
        },
        "Fact": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" }
            }
        }
    }
}
